# Copy this file to .env.local and add real credentials there. Never commit secrets.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Local Logfire credentials are stored in ignored .logfire/ after project setup.
# For deployment, inject a project write token through the secret manager.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
# Set false to disable telemetry export (for example, during tests).
# LOGFIRE_SEND_TO_LOGFIRE=false
