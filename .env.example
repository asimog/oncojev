# Copy this file to .env.local and add real credentials there. Never commit secrets.
# Use 1 for isolated local application testing; process values override this file.
# Timing/data ceilings live in config/runtime.yaml under testing. Providers and
# scientific procedures stay unchanged. Each process retains a new testing/<uuid>.
# Only literal 0/1 are accepted. Existing DB overrides must stay inside that run root.
ONCOJEV_TESTING=0
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Local Logfire credentials are stored in ignored .logfire/ after project setup.
# For deployment, inject a project write token through the secret manager.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
# Set false to disable telemetry export (for example, during tests).
# LOGFIRE_SEND_TO_LOGFIRE=false
